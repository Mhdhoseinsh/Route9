# تنظیم کش برای فایل‌های استاتیک
/favicon.ico
  Cache-Control: public, max-age=31536000

# تنظیم کش برای یک سال برای فایل‌های CSS و JS
/*.css
  Cache-Control: public, max-age=31536000
/*.js
  Cache-Control: public, max-age=31536000

# تنظیم کش برای یک سال برای عکس‌ها
*.webp
  Cache-Control: public, max-age=31536000
*.png
  Cache-Control: public, max-age=31536000
*.jpg
  Cache-Control: public, max-age=31536000

# برای خود صفحه HTML (می‌تواند ۱۰ دقیقه بماند چون اگر محتوا تغییر کرد کاربر فوراً ببیند)
/index.html
  Cache-Control: public, max-age=600
